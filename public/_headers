# Cloudflare Pages response headers.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# Bluesky resolves the bot-tan.com handle by fetching this file. It must stay
# reachable and be served as plain text, or Bot-tan's handle stops verifying.
/.well-known/atproto-did
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300
  Access-Control-Allow-Origin: *

# Astro fingerprints everything under /_astro/, so it can be cached forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
