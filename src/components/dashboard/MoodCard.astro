---
import { STATUSES, type Dictionary } from '../../i18n';
import { STATUS_EMOJI } from '../../lib/dashboardTheme';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
---

<div class="mood">
  <div class="mood__now">
    <p class="mood__label">{t.dashboard.mood.heading}</p>
    <p class="mood__value" id="mood-text">---</p>
    <p class="mood__next">
      {t.dashboard.mood.nextLabel}: <span id="next-step-time">---</span>
    </p>
  </div>

  {/*
    A ratio against a fixed limit, so it is a meter: the unfilled part of the
    track is a lighter step of the same ramp, and the fill carries the level.
  */}
  <div class="mood__energy">
    <p class="mood__label">
      {t.dashboard.energy.label}: <span class="mood__energy-value" id="ability-energy">---%</span>
    </p>
    <div
      class="meter"
      id="energy-meter"
      role="meter"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-label={t.dashboard.energy.label}
    >
      <span class="meter__fill" id="energy-fill"></span>
    </div>
  </div>

  <div class="mood__states">
    <p class="mood__label">{t.dashboard.mood.statusHeading}</p>
    <ul class="states">
      {
        STATUSES.map((status) => (
          <li class="state" id={`state-${status}`} data-status={status}>
            <span class="state__emoji" aria-hidden="true">
              {STATUS_EMOJI[status]}
            </span>
            <span class="state__name">{t.dashboard.mood.statusLabels[status]}</span>
            <span class="state__score" id={`utility-${status}`}>
              ---
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  /*
   * Stacked, not side by side: Bot-tan writes her mood freely and a real one
   * runs to a couple of hundred characters. In a narrow column that became a
   * sixteen-line ribbon, so the text gets the full width and the state tiles
   * sit underneath.
   */
  .mood {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1fr;
  }

  .mood__label {
    margin: 0 0 0.4rem;
    font-family: var(--font-hand);
    font-size: 0.9rem;
    color: var(--color-ink-soft);
  }

  .mood__value {
    margin: 0;
    max-width: 60ch;
    font-family: var(--font-hand);
    font-size: clamp(1.1rem, 2.6vw, 1.4rem);
    line-height: 1.75;
    color: var(--color-sky-deep);
  }

  .mood__next {
    margin: 0.5rem 0 0;
    font-size: 0.8rem;
    color: var(--color-ink-soft);
    font-variant-numeric: tabular-nums;
  }

  .mood__energy-value {
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
  }

  .meter {
    height: 0.9rem;
    border-radius: 999px;
    overflow: hidden;
    /* The empty part of the track is a lighter step of the fill's own ramp, so
       the level reads across the whole bar rather than only where it stops. */
    background: color-mix(in srgb, var(--color-sky-deep) 14%, var(--color-paper));
    border: 1.5px solid color-mix(in srgb, var(--color-sky-deep) 26%, transparent);
  }

  .meter__fill {
    display: block;
    height: 100%;
    width: var(--level, 0%);
    border-radius: inherit;
    background: var(--meter-color, var(--color-sky-deep));
    transition: width 400ms ease, background 400ms ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .meter__fill {
      transition: none;
    }
  }

  .states {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
    grid-template-columns: repeat(auto-fit, minmax(6.2rem, 1fr));
  }

  .state {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.15rem;
    padding: 0.6rem 0.4rem;
    border-radius: 0.5rem;
    border: 1.5px solid color-mix(in srgb, var(--color-ink) 18%, transparent);
    background: color-mix(in srgb, var(--color-paper) 80%, transparent);
    transition: background 250ms ease, border-color 250ms ease, scale 250ms ease;
  }

  /* The state Bot-tan is currently in gets the highlighter treatment. */
  .state[data-active='true'] {
    background: var(--color-marker);
    border-color: var(--color-kotomi);
    scale: 1.06;
    animation: wobble-in 400ms ease;
  }

  .state__emoji {
    font-family: var(--font-emoji);
    font-size: 1.5rem;
    line-height: 1.3;
    /* Greyed out until it becomes the active state. */
    filter: grayscale(0.7);
    opacity: 0.65;
    transition: filter 250ms ease, opacity 250ms ease;
  }

  .state[data-active='true'] .state__emoji {
    filter: none;
    opacity: 1;
  }

  .state__name {
    font-family: var(--font-hand);
    font-size: 0.78rem;
    text-align: center;
    line-height: 1.35;
  }

  .state__score {
    font-size: 0.72rem;
    color: var(--color-ink-soft);
    font-variant-numeric: tabular-nums;
  }
</style>
