---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SketchCard from './SketchCard.astro';
import type { CharacterCopy } from '../i18n';

interface Props {
  character: CharacterCopy;
  image: ImageMetadata;
  /** Accent colour for the hand-drawn frame. */
  color: string;
  /** Darker variant used for text, where the pastel frame colour is too faint. */
  inkColor?: string;
  /** Put the illustration on the right instead of the left. */
  flip?: boolean;
  seed: string;
  eager?: boolean;
}

const { character, image, color, inkColor = color, flip = false, seed, eager = false } = Astro.props;
---

<SketchCard seed={seed} color={color} double class:list={['character', flip && 'character--flip']}>
  <div class="character__grid">
    <div class="character__art" data-reveal={flip ? 'right' : 'left'} style="--reveal-delay:120ms">
      <Image
        src={image}
        alt={character.imageAlt}
        widths={[280, 460, 640]}
        sizes="(max-width: 820px) 62vw, 22rem"
        loading={eager ? 'eager' : 'lazy'}
      />
    </div>

    <div class="character__text">
      <p class="character__name" style={`--accent:${inkColor}`}>
        <span class="character__emoji" aria-hidden="true">{character.emoji}</span>
        {character.name}
      </p>
      <p class="character__tagline">{character.tagline}</p>

      <h3 class="character__sub" style={`--accent:${inkColor}`}>{character.profileHeading}</h3>
      <dl class="character__profile">
        {
          character.profile.map((row) => (
            <div class="character__row">
              <dt style={`--accent:${inkColor}`}>{row.label}</dt>
              <dd>{row.value}</dd>
            </div>
          ))
        }
      </dl>

      <h3 class="character__sub" style={`--accent:${inkColor}`}>{character.personalityHeading}</h3>
      {character.personality.map((p) => <p class="character__para">{p}</p>)}

      <slot />
    </div>
  </div>
</SketchCard>

<style>
  .character__grid {
    display: grid;
    gap: clamp(1.25rem, 4vw, 2.5rem);
    grid-template-columns: 1fr;
    align-items: start;
  }

  @media (min-width: 820px) {
    .character__grid {
      grid-template-columns: minmax(0, 20rem) minmax(0, 1fr);
    }
    :global(.character--flip) .character__art {
      order: 2;
    }
  }

  .character__art {
    justify-self: center;
    max-width: 22rem;
    width: 100%;
  }

  .character__art :global(img) {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 0.75rem;
    filter: drop-shadow(0 12px 18px rgb(61 55 51 / 0.16));
  }

  .character__name {
    margin: 0;
    font-family: var(--font-hand);
    font-size: clamp(1.35rem, 3.6vw, 1.9rem);
    color: var(--accent);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .character__emoji {
    font-family: var(--font-emoji);
  }

  .character__tagline {
    margin: 0.2rem 0 1.5rem;
    color: var(--color-ink-soft);
    font-size: 0.95rem;
  }

  .character__sub {
    margin: 1.75rem 0 0.75rem;
    font-family: var(--font-hand);
    font-size: 1.1rem;
    color: var(--color-ink);
    display: inline-block;
    border-bottom: 2px dashed color-mix(in srgb, var(--accent) 60%, transparent);
    padding-bottom: 0.15rem;
  }

  .character__sub:first-of-type {
    margin-top: 0;
  }

  .character__profile {
    margin: 0;
    display: grid;
    gap: 0.35rem;
  }

  .character__row {
    display: grid;
    grid-template-columns: minmax(5.5rem, auto) 1fr;
    gap: 0.75rem;
    align-items: baseline;
  }

  .character__row dt {
    margin: 0;
    font-family: var(--font-hand);
    font-size: 0.9rem;
    color: color-mix(in srgb, var(--accent) 75%, var(--color-ink));
  }

  .character__row dd {
    margin: 0;
    font-size: 0.95rem;
  }

  .character__para {
    margin: 0 0 0.75rem;
    font-size: 0.98rem;
  }

  .character__para:last-of-type {
    margin-bottom: 0;
  }

  @media (max-width: 480px) {
    .character__row {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .character__row + .character__row {
      margin-top: 0.5rem;
    }
  }
</style>
