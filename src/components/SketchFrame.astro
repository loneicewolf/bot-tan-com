---
import { sketchRect } from '../lib/sketch';

interface Props {
  /** Distinguishes one frame's wobble from another. */
  seed: string;
  /** Any CSS colour. Defaults to the ink colour. */
  color?: string;
  strokeWidth?: number;
  radius?: number;
  jitter?: number;
  /** Trace the border twice for a sketchier line. */
  double?: boolean;
  /** Delay before the draw-in animation starts. */
  delay?: number;
  class?: string;
}

const {
  seed,
  color = 'var(--color-ink)',
  strokeWidth = 2,
  radius = 6,
  jitter = 0.7,
  double = false,
  delay = 120,
  class: className = '',
} = Astro.props;

const { d, dSecond, length, viewBox } = sketchRect({ seed, radius, jitter, double });
---

<svg
  class:list={['sketch-frame', className]}
  viewBox={viewBox}
  preserveAspectRatio="none"
  aria-hidden="true"
  focusable="false"
  style={`--sketch-length:${length}; --sketch-delay:${delay}ms; color:${color};`}
>
  <path
    d={d}
    fill="none"
    stroke="currentColor"
    stroke-width={strokeWidth}
    stroke-linecap="round"
    stroke-linejoin="round"
    vector-effect="non-scaling-stroke"
  />
  {
    dSecond && (
      <path
        d={dSecond}
        fill="none"
        stroke="currentColor"
        stroke-width={strokeWidth * 0.6}
        stroke-linecap="round"
        stroke-linejoin="round"
        opacity="0.45"
        vector-effect="non-scaling-stroke"
      />
    )
  }
</svg>

<style>
  .sketch-frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }
</style>
