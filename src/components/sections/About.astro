---
import { Image } from 'astro:assets';
import botTan from '../../assets/characters/bot-tan.png';
import nagiIcon from '../../assets/brand/nagi-icon.png';
import Section from '../Section.astro';
import CharacterCard from '../CharacterCard.astro';
import { useTranslations, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<Section id="about" heading={t.about.heading} lead={t.about.lead} color="var(--color-sky-deep)">
  <CharacterCard
    seed="card-bot-tan"
    character={t.about.character}
    image={botTan}
    color="var(--color-sky-deep)"
  >
    <div class="sns">
      <h3 class="sns__heading">{t.about.snsHeading}</h3>
      <div class="sns__row">
        <a
          class="sns__link"
          href="https://nagi.suibari.com/profile/did:plc:qcwhrvzx6wmi5hz775uyi6fh"
          target="_blank"
          rel="noopener noreferrer"
        >
          <Image src={nagiIcon} alt="" width={36} height={36} loading="lazy" class="sns__icon" />
          Nagi
        </a>

        <a
          class="sns__link"
          href="https://bsky.app/profile/bot-tan.com"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
            <path
              fill="currentColor"
              d="M5.77 3.39C8.32 5.3 11.06 9.18 12 11.26c.94-2.08 3.68-5.96 6.23-7.87C20.07 2 23 .98 23 4.33c0 .67-.38 5.62-.61 6.42-.78 2.8-3.63 3.51-6.17 3.08 4.43.75 5.56 3.25 3.12 5.74-4.62 4.74-6.64-1.19-7.16-2.71-.1-.28-.14-.4-.14-.29 0-.11-.05.01-.14.29-.52 1.52-2.54 7.45-7.16 2.71-2.44-2.49-1.31-4.99 3.12-5.74-2.54.43-5.39-.28-6.17-3.08C.62 9.95.24 5 .24 4.33.24.98 3.17 2 5.01 3.39Z"
            ></path>
          </svg>
          Bluesky
        </a>

        <a
          class="sns__link"
          href="https://github.com/suibari/bsky-affirmative-bot"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
            <path
              fill="currentColor"
              d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 0-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2 0-.4-.5-1.6.2-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17.3 4.9 18.3 5.2 18.3 5.2c.7 1.6.2 2.8.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.5.4.9 1.1.9 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3Z"
            ></path>
          </svg>
          GitHub
        </a>
      </div>
    </div>
  </CharacterCard>

  <ul class="notes">
    {
      t.about.notes.map((note, i) => (
        <li class="note" data-reveal="pop" style={`--reveal-delay:${i * 90}ms; --tilt:${(i % 3) - 1}deg`}>
          <span class="note__emoji" aria-hidden="true">
            {note.emoji}
          </span>
          <span class="note__text">{note.text}</span>
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .sns {
    margin-top: 2rem;
  }

  .sns__heading {
    margin: 0 0 0.75rem;
    font-family: var(--font-hand);
    font-size: 1.05rem;
  }

  .sns__row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .sns__link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 1rem;
    font-family: var(--font-hand);
    font-size: 0.95rem;
    color: var(--color-ink);
    text-decoration: none;
    border: 2px solid var(--color-ink);
    border-radius: 16px 11px 18px 10px;
    background: var(--color-paper);
    transition: background 160ms ease, rotate 160ms ease;
  }

  .sns__link :global(.sns__icon) {
    width: 1.15rem;
    height: 1.15rem;
    display: block;
  }

  .sns__link:hover,
  .sns__link:focus-visible {
    background: var(--color-marker);
    rotate: -1.5deg;
  }

  /* Sticky notes stuck to the page under the profile card. */
  .notes {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
  }

  .note {
    display: flex;
    gap: 0.7rem;
    padding: 1rem 1.1rem;
    font-size: 0.92rem;
    line-height: 1.75;
    background: color-mix(in srgb, var(--color-marker) 42%, var(--color-paper));
    border-radius: 0.4rem;
    rotate: var(--tilt);
    box-shadow: 0 6px 14px -10px rgb(61 55 51 / 0.6);
  }

  .note__emoji {
    font-family: var(--font-emoji);
    font-size: 1.15rem;
    line-height: 1.5;
    flex-shrink: 0;
  }
</style>
