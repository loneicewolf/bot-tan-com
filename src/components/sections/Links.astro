---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import nagiIcon from '../../assets/brand/nagi-icon.png';
import botIcon from '../../assets/brand/bot-icon.png';
import BrandIcon from '../BrandIcon.astro';
import { hasBrandIcon } from '../../lib/brandIcons';
import Section from '../Section.astro';
import SketchFrame from '../SketchFrame.astro';
import { useTranslations, type Lang, type LinkId } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

/**
 * Artwork for the places that have their own mark. Anything not listed here
 * falls back to the emoji carried in the dictionary.
 */
const artwork: Partial<Record<LinkId, ImageMetadata>> = {
  nagi: nagiIcon,
  room: botIcon,
};

/** Border colours, and the darker ink variants used for the titles on paper. */
const accents = ['var(--color-morpho)', 'var(--color-sky-deep)', 'var(--color-latte)'];
const accentInks = ['var(--color-morpho)', 'var(--color-sky-deep)', 'var(--color-latte-ink)'];
---

<Section id="links" heading={t.links.heading} lead={t.links.lead} color="var(--color-morpho)">
  <ul class="primary">
    {
      t.links.primary.map((link, i) => (
        <li data-reveal="pop" style={`--reveal-delay:${i * 130}ms`}>
          <a
            class="primary__card"
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            style={`--accent:${accents[i % accents.length]}; --accent-ink:${accentInks[i % accentInks.length]}`}
          >
            <SketchFrame
              seed={`link-${link.id}`}
              color={accents[i % accents.length]}
              strokeWidth={2.4}
              double
            />
            <span class="primary__body">
              <span class="primary__mark">
                {artwork[link.id] ? (
                  <Image src={artwork[link.id]!} alt="" width={110} height={110} loading="lazy" />
                ) : (
                  <BrandIcon id={link.id} size={44} />
                )}
              </span>
              <span class="primary__title">{link.title}</span>
              <span class="primary__desc">{link.description}</span>
              <span class="primary__go" aria-hidden="true">
                →
              </span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>

  <h3 class="secondary__heading" data-reveal="up">{t.links.secondaryHeading}</h3>
  <ul class="secondary">
    {
      t.links.secondary.map((link, i) => (
        <li data-reveal="up" style={`--reveal-delay:${i * 70}ms`}>
          <a class="secondary__row" href={link.href} target="_blank" rel="noopener noreferrer">
            <span class="secondary__mark">
              {hasBrandIcon(link.id) ? (
                <BrandIcon id={link.id} size={20} />
              ) : (
                <span class="secondary__emoji" aria-hidden="true">{link.emoji}</span>
              )}
            </span>
            <span class="secondary__text">
              <span class="secondary__title">{link.title}</span>
              <span class="secondary__desc">{link.description}</span>
            </span>
            <span class="secondary__go" aria-hidden="true">
              →
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .primary {
    list-style: none;
    margin: 0 0 3.5rem;
    padding: 0;
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
  }

  .primary__card {
    position: relative;
    display: block;
    height: 100%;
    padding: 1.75rem 1.5rem;
    border-radius: 0.75rem;
    text-decoration: none;
    color: var(--color-ink);
    background: var(--color-paper);
    transition: translate 200ms ease, rotate 200ms ease, box-shadow 200ms ease;
  }

  .primary__card:hover,
  .primary__card:focus-visible {
    translate: 0 -6px;
    rotate: -0.8deg;
    box-shadow: 0 16px 30px -20px color-mix(in srgb, var(--accent) 80%, transparent);
  }

  .primary__body {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 0.4rem;
  }

  .primary__mark {
    display: flex;
    align-items: flex-end;
    height: 3.4rem;
    margin-bottom: 0.35rem;
    color: var(--accent-ink);
  }

  .primary__mark :global(img) {
    width: auto;
    height: 3.2rem;
    display: block;
  }

  .primary__emoji {
    font-family: var(--font-emoji);
    font-size: 2.2rem;
    line-height: 1;
  }

  .primary__title {
    font-family: var(--font-hand);
    font-size: 1.3rem;
    color: var(--accent-ink);
  }

  .primary__desc {
    font-size: 0.88rem;
    line-height: 1.75;
    color: color-mix(in srgb, var(--color-ink) 85%, transparent);
  }

  .primary__go {
    margin-top: 0.4rem;
    font-family: var(--font-hand);
    color: var(--accent-ink);
    transition: translate 200ms ease;
  }

  .primary__card:hover .primary__go {
    translate: 0.35rem 0;
  }

  .secondary__heading {
    margin: 0 0 1.25rem;
    font-family: var(--font-hand);
    font-size: 1.15rem;
    color: var(--color-ink-soft);
  }

  .secondary {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
    max-width: 46rem;
  }

  .secondary__row {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.75rem 1rem;
    border-radius: 0.6rem;
    text-decoration: none;
    color: var(--color-ink);
    border: 2px dashed color-mix(in srgb, var(--color-ink) 25%, transparent);
    background: color-mix(in srgb, var(--color-paper) 96%, transparent);
    transition: border-color 180ms ease, background 180ms ease, translate 180ms ease;
  }

  .secondary__row:hover,
  .secondary__row:focus-visible {
    border-color: var(--color-sky-deep);
    background: var(--color-paper);
    translate: 4px 0;
  }

  .secondary__mark {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.6rem;
    flex-shrink: 0;
    color: var(--color-sky-deep);
  }

  .secondary__emoji {
    font-family: var(--font-emoji);
    font-size: 1.25rem;
    line-height: 1;
  }

  .secondary__text {
    display: grid;
    gap: 0.1rem;
    flex: 1;
    min-width: 0;
  }

  .secondary__title {
    font-family: var(--font-hand);
    font-size: 1rem;
  }

  .secondary__desc {
    font-size: 0.82rem;
    color: var(--color-ink-soft);
    line-height: 1.6;
  }

  .secondary__go {
    color: var(--color-ink-soft);
    flex-shrink: 0;
  }
</style>
